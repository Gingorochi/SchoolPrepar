{% extends 'front/base.html.twig' %}

{% block title %}{{ filiere.nom }}{% endblock %}

{% block body %}

{# Header #}
<div class="filiere-header">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('home') }}" class="text-white-50">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('filiere_index') }}" class="text-white-50">Filières</a></li>
                <li class="breadcrumb-item active text-white">{{ filiere.nom }}</li>
            </ol>
        </nav>
        <span class="badge-filiere mb-3 d-inline-block">{{ filiere.domaine }}</span>
        <h1 class="display-4">{{ filiere.nom }}</h1>
        <p class="lead text-white-75">{{ filiere.description|slice(0, 150) }}...</p>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            {# Colonne principale #}
            <div class="col-lg-8">
                <div class="card card-custom p-4 mb-4">
                    <h4 class="fw-600 mb-3 text-primary">
                        <i class="fas fa-info-circle me-2 text-secondary"></i>Description complète
                    </h4>
                    <p class="text-muted lh-base">{{ filiere.description }}</p>
                </div>

                <div class="card card-custom p-4">
                    <h4 class="fw-600 mb-3 text-primary">
                        <i class="fas fa-list-check me-2 text-secondary"></i>Débouchés professionnels
                    </h4>
                    <ul class="list-unstyled">
                        {% for debouche in filiere.debouches %}
                        <li class="d-flex align-items-center mb-2">
                            <span class="badge bg-secondary rounded-circle me-3" style="width: 8px; height: 8px;"></span>
                            {{ debouche }}
                        </li>
                        {% else %}
                        <li class="text-muted">Débouchés non renseignés.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            {# Sidebar infos #}
            <div class="col-lg-4">
                <div class="card card-custom p-4 mb-4 border-secondary" style="border-top-width: 4px;">
                    <h5 class="fw-600 mb-4 text-primary">Informations clés</h5>
                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                        <span class="text-muted"><i class="fas fa-clock me-2"></i>Durée</span>
                        <span class="fw-600">{{ filiere.duree }} ans</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                        <span class="text-muted"><i class="fas fa-language me-2"></i>Langue</span>
                        <span class="fw-600">{{ filiere.langue }}</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                        <span class="text-muted"><i class="fas fa-tag me-2"></i>Domaine</span>
                        <span class="fw-600">{{ filiere.domaine }}</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted"><i class="fas fa-school me-2"></i>Établissements</span>
                        <span class="fw-600">{{ filiere.etablissements|length }}</span>
                    </div>
                </div>

                <a href="{{ path('filiere_index') }}" class="btn w-100 btn-primary fw-semibold rounded">
                    <i class="fas fa-arrow-left me-2"></i>Retour aux filières
                </a>
            </div>

        </div>
    </div>
</section>

{% endblock %}
