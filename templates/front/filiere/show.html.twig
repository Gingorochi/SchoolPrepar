{% extends 'front/base.html.twig' %}

{% block title %}{{ filiere.nom }} - SchoolPrepar{% endblock %}

{% block body %}
<style>
.filiere-show { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 120px 0 80px; }
.filiere-badge { background: rgba(255,255,255,0.2); backdrop-filter: blur(10px); padding: 8px 16px; border-radius: 50px; font-weight: 600; }
.info-box { background: rgba(255,255,255,0.95); border-radius: 15px; padding: 25px; margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
.debouch-list li { padding: 12px; margin-bottom: 8px; background: #f8f9fa; border-radius: 8px; border-left: 4px solid #667eea; }
</style>

{# Header Hero #}
<div class="filiere-show">
    <div class="container">
        <nav style="margin-bottom: 30px;">
            <a href="{{ path('app_home') }}" class="text-white-50 me-3"><i class="fas fa-home"></i> Accueil</a>
            <span class="text-white-50">></span>
            <a href="{{ path('app_filiere_index') }}" class="text-white-50 me-3 ms-3">Filières</a>
            <span class="text-white-50">></span>
            <span class="text-white">{{ filiere.nom }}</span>
        </nav>
        <span class="filiere-badge">{{ filiere.domaine }}</span>
        <h1 style="font-size: 3.5rem; font-weight: 700; margin: 20px 0;">{{ filiere.nom }}</h1>
    </div>
</div>

<!-- Section principale CORRIGÉE -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="info-box">
                    <h3 style="color: #333; margin-bottom: 20px;">
                        <i class="fas fa-info-circle me-3 text-primary"></i>Description complète
                    </h3>
                    <p style="line-height: 1.8; font-size: 1.1rem; color: #555;">{{ filiere.description }}</p>
                </div>

                <div class="info-box">
                    <h3 style="color: #333; margin-bottom: 25px;">
                        <i class="fas fa-school me-3 text-success"></i>Établissements proposant cette formation
                    </h3>
                    <ul class="list-unstyled">
                        {% for etablissement in filiere.etablissements %}
                            <li>{{ etablissement.nom }} ({{ etablissement.ville }})</li>
                        {% else %}
                            <li>Aucun établissement trouvé</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card border-secondary mb-4" style="border-top-width: 4px; border-top-color: #667eea;">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 text-primary">Informations clés</h5>
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <span class="text-muted"><i class="fas fa-clock me-2"></i>Durée</span>
                            <span class="fw-bold">{{ filiere.duree }} ans</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <span class="text-muted"><i class="fas fa-language me-2"></i>Langue</span>
                            <span class="fw-bold">{{ filiere.langue }}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                            <span class="text-muted"><i class="fas fa-tag me-2"></i>Domaine</span>
                            <span class="fw-bold">{{ filiere.domaine }}</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted"><i class="fas fa-school me-2"></i>Établissements</span>
                            <span class="fw-bold">{{ filiere.etablissements|length }}</span>
                        </div>
                    </div>
                </div>

                <a href="{{ path('app_filiere_index') }}" class="btn btn-primary w-100 fw-semibold">
                    <i class="fas fa-arrow-left me-2"></i>Retour aux filières
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
