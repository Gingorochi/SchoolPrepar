{% extends 'front/base.html.twig' %}

{% block title %}Établissements - SchoolPrepar{% endblock %}



{% block body %}

    {# 1. HEADER DE PAGE (Style Scholar) #}
    <div class="main-banner" id="top">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="owl-carousel owl-banner">
                        <div class="item item-1">
                            <div class="header-text">
                                <span class="category">Partenaires Académiques</span>
                                <h2>Nos Établissements</h2>
                                <p>Découvrez les instituts et universités partenaires où vous pouvez suivre vos formations au Togo.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# 2. SECTION LISTE #}
    <section class="section courses" id="courses" style="margin-top: 0; padding-top: 60px;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="section-heading">
                        <h6>{{ etablissements|length }} Établissements disponibles</h6>
                        <h2>Où étudier ?</h2>
                    </div>
                    
                    {# Barre de recherche stylisée Scholar #}
                    <div class="search-bar mb-5" style="max-width: 500px; margin: 0 auto;">
                        <input type="text" id="searchEtab" class="form-control search-input" 
                               placeholder="🔍 Rechercher un établissement (Lomé, Université...)">
                    </div>
                </div>
            </div>

            <div class="row" id="etabList">
                {% for etab in etablissements %}
                <div class="col-lg-4 col-md-6 mb-4 etab-item">
                    <div class="events_item">
                        <div class="thumb" style="background-color: #7a6ad8; display: flex; align-items: center; justify-content: center; min-height: 180px;">
                            {% if etab.imagePath %}
                                <img src="{{ asset('uploads/etablissements/' ~ etab.imagePath) }}" alt="Image de {{ etab.nom }}" style="width: 100%; height: 180px; object-fit: cover;" />
                            {% else %}
                                <i class="fas fa-school" style="color: #fff; font-size: 36px;"></i>
                            {% endif %}
                        </div>

                        <div class="down-content">
                            <span class="author"><i class="fas fa-map-marker-alt"></i> {{ etab.ville }}</span>
                            <h4>{{ etab.nom }}</h4>
                            <p>{{ etab.description|slice(0, 100) }}...</p>
                            <div class="main-button">
                                <a href="#">Voir les filières ({{ etab.filieres|length }})</a>
                            </div>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="col-lg-12 text-center">
                    <p>Aucun établissement trouvé.</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
<script>
    document.getElementById('searchEtab').addEventListener('input', function() {
        const query = this.value.toLowerCase();
        document.querySelectorAll('.etab-item').forEach(function(item) {
            const text = item.innerText.toLowerCase();
            item.style.display = text.includes(query) ? 'block' : 'none';
        });
    });
</script>
{% endblock %}