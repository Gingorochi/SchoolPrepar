{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Établissements - SchoolPrepar Admin{% endblock %}

{% block content %}
<div class="page-header mb-32">
    <div class="d-flex justify-content-between align-items-center mb-24">
        <div>
            <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 8px; color: var(--text-primary);">
                Gestion des Établissements
            </h1>
            <p style="color: var(--text-muted);">Administrez les établissements partenaires</p>
        </div>
        <a href="{{ path('admin_etablissement_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvel Établissement
        </a>
    </div>
</div>

<div class="table-container">
    <div class="card-header">
        <h5 class="mb-0">Liste des Établissements</h5>
    </div>
    <div class="card-body">
        {% if etablissements|length > 0 %}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Ville</th>
                            <th>Type</th>
                            <th>Téléphone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for etab in etablissements %}
                        <tr>
                            <td>
                                <span style="color: #111827; font-weight: 700;">{{ etab.nom }}</span>
                            </td>
                            <td>
                                <span style="color: #111827; font-weight: 500;">{{ etab.ville }}</span>
                            </td>
                            <td>
                                <span class="badge badge-info">{{ etab.type }}</span>
                            </td>
                            <td>
                                {{ etab.telephone ?? '-' }}
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('admin_etablissement_show', {id: etab.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_etablissement_edit', {id: etab.id}) }}" class="btn btn-sm btn-secondary" title="Éditer">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" action="{{ path('admin_etablissement_delete', {id: etab.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etab.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div style="text-align: center; padding: 48px 24px;">
                <i class="fas fa-inbox" style="font-size: 3rem; color: var(--text-muted); opacity: 0.5; margin-bottom: 16px; display: block;"></i>
                <p style="color: var(--text-muted); font-size: 1.05rem;">
                    Aucun établissement trouvé.
                </p>
                <a href="{{ path('admin_etablissement_new') }}" class="btn btn-primary mt-3">
                    <i class="fas fa-plus"></i> Créer un établissement
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .page-header {
        margin-bottom: 32px;
    }
    
    .btn-group {
        display: flex;
        gap: 8px;
    }
    
    .table-responsive {
        overflow-x: auto;
    }
</style>
{% endblock %}

