{% extends 'admin/base.html.twig' %}

{% block title %}etablissement{% endblock %}

{% block body %}

<div class="section events" id="events">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <div class="section-heading">
            <h6>Partenaires</h6>
            <h2>Établissements d'enseignement</h2>
          </div>
        </div>
        
        {% for etab in etablissements %}
        <div class="col-lg-12 col-md-6">
          <div class="item">
            <div class="row">
              <div class="col-lg-3">
                <div class="image">
                  <img src="{{ asset('assets/images/event-01.jpg') }}" alt="">
                </div>
              </div>
              <div class="col-lg-9">
                <ul>
                  <li>
                    <span class="category">Université / Institut</span>
                    <h4>{{ etab.nom }}</h4>
                  </li>
                  <li>
                    <span>Ville:</span>
                    <h6>{{ etab.ville }}</h6>
                  </li>
                  <li>
                    <span>Contact:</span>
                    <h6>{{ etab.telephone }}</h6>
                  </li>
                </ul>
                <a href="#"><i class="fa fa-angle-right"></i></a>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
</div>
{% endblock %}

