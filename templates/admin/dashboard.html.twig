{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard - SchoolPrepar Admin{% endblock %}

{% block stylesheets %}
<style>
    .dashboard-header {
        margin-bottom: 32px;
    }

    .dashboard-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--text-primary);
    }

    .dashboard-header p {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 32px;
    }

    .stats-card {
        background: linear-gradient(135deg, var(--dark-tertiary) 0%, rgba(79, 70, 229, 0.05) 100%);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: all 0.3s;
    }

    .stats-card:hover {
        border-color: var(--accent-primary);
        transform: translateY(-4px);
        box-shadow: 0 12px 32px rgba(79, 70, 229, 0.2);
    }

    .stats-icon-box {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        flex-shrink: 0;
    }

    .stats-icon-box.primary {
        background: linear-gradient(135deg, rgba(79, 70, 229, 0.2), rgba(6, 182, 212, 0.1));
        color: var(--accent-primary);
    }

    .stats-icon-box.success {
        background: rgba(34, 197, 94, 0.15);
        color: #86efac;
    }

    .stats-icon-box.warning {
        background: rgba(245, 158, 11, 0.15);
        color: #fcd34d;
    }

    .stats-icon-box.danger {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
    }

    .stats-content h3 {
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .stats-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1;
    }

    .stats-change {
        font-size: 0.8rem;
        margin-top: 8px;
        color: var(--text-muted);
    }

    .stats-change.positive {
        color: #86efac;
    }

    .stats-change.negative {
        color: #fca5a5;
    }

    /* Table Container */
    .table-container {
        background: var(--dark-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .table-container .card-header {
        background: rgba(79, 70, 229, 0.08);
        border-bottom: 1px solid var(--border-color);
        padding: 20px;
    }

    /* Row Animation */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stats-card {
        animation: fadeInUp 0.6s ease-out;
    }

    .stats-card:nth-child(1) { animation-delay: 0.05s; }
    .stats-card:nth-child(2) { animation-delay: 0.1s; }
    .stats-card:nth-child(3) { animation-delay: 0.15s; }
    .stats-card:nth-child(4) { animation-delay: 0.2s; }
</style>
{% endblock %}

{% block content %}
{# Dashboard Header #}
<div class="dashboard-header">
    <h1>Bienvenue dans votre tableau de bord</h1>
    <p>Voici un aperçu de votre plateforme de formation</p>
</div>

{# Statistics Cards #}
<div class="stats-grid">
    {# Total Utilisateurs #}
    <div class="stats-card">
        <div class="stats-icon-box primary">
            <i class="fas fa-users"></i>
        </div>
        <div class="stats-content">
            <h3>Utilisateurs</h3>
            <div class="stats-number">{{ utilisateurs_count ?? 0 }}</div>
            <div class="stats-change positive">
                <i class="fas fa-arrow-up"></i> +12% ce mois
            </div>
        </div>
    </div>

    {# Total Filières #}
    <div class="stats-card">
        <div class="stats-icon-box success">
            <i class="fas fa-graduation-cap"></i>
        </div>
        <div class="stats-content">
            <h3>Filières</h3>
            <div class="stats-number">{{ filieres_count ?? 0 }}</div>
            <div class="stats-change positive">
                <i class="fas fa-arrow-up"></i> +3% ce mois
            </div>
        </div>
    </div>

    {# Total Établissements #}
    <div class="stats-card">
        <div class="stats-icon-box warning">
            <i class="fas fa-building"></i>
        </div>
        <div class="stats-content">
            <h3>Établissements</h3>
            <div class="stats-number">{{ etablissements_count ?? 0 }}</div>
            <div class="stats-change positive">
                <i class="fas fa-arrow-up"></i> +1% ce mois
            </div>
        </div>
    </div>

    {# Événements #}
    <div class="stats-card">
        <div class="stats-icon-box danger">
            <i class="fas fa-calendar"></i>
        </div>
        <div class="stats-content">
            <h3>Événements</h3>
            <div class="stats-number">{{ evenements_count ?? 0 }}</div>
            <div class="stats-change negative">
                <i class="fas fa-arrow-down"></i> -5% ce mois
            </div>
        </div>
    </div>
</div>

{# Recent Users Table #}
<div class="row">
    <div class="col-12">
        <div class="table-container">
            <div class="card-header">
                <h5 class="mb-0">Utilisateurs récents</h5>
            </div>
            <div class="card-body">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if users is defined and users|length > 0 %}
                            {% for user in users[:5] %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width: 32px; height: 32px; background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 0.85rem;">
                                            {{ user.prenom[0:1]|upper }}
                                        </div>
                                        <span>{{ user.prenom }} {{ user.nom }}</span>
                                    </div>
                                </td>
                                <td>{{ user.email }}</td>
                                <td>
                                    <span class="badge {% if user.role == 'ADMIN' %}badge-danger{% else %}badge-info{% endif %}">
                                        {{ user.role == 'ADMIN' ? 'Administrateur' : 'Utilisateur' }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-success">Actif</span>
                                </td>
                                <td>
                                    <a href="{{ path('admin_user_show', {id: user.id}) }}" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    <i class="fas fa-inbox"></i> Aucun utilisateur
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}