<div class="topbar">
    <div class="d-flex align-items-center gap-3 flex-grow-1">
        <h2 class="mb-0 fs-5" style="font-weight: 600; color: var(--text-primary);">
            {% block topbar_title %}Tableau de bord{% endblock %}
        </h2>
    </div>

    <div class="topbar-right">
        <div class="search-bar d-none d-md-block">
            <i class="fas fa-search search-icon"></i>
            <input type="text" placeholder="Rechercher..." class="form-control" style="padding-left: 40px;">
        </div>

        <button class="topbar-btn" title="Notifications">
            <i class="fas fa-bell"></i>
            <span style="position: absolute; top: 8px; right: 20px; width: 8px; height: 8px; background: var(--accent-primary); border-radius: 50%;"></span>
        </button>

        <div style="width: 40px; height: 40px; background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600;">
            {{ app.user.prenom[0:1]|upper }}
        </div>
    </div>
</div>