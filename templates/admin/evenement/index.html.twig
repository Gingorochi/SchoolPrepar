{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Événements - SchoolPrepar Admin{% endblock %}

{% block content %}
<div class="page-header mb-32">
    <div class="d-flex justify-content-between align-items-center mb-24">
        <div>
            <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 8px; color: var(--text-primary);">
                Gestion des Événements
            </h1>
            <p style="color: var(--text-muted);">Administrez les événements des filières</p>
        </div>
        <a href="{{ path('admin_evenement_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvel Événement
        </a>
    </div>
</div>

<div class="table-container">
    <div class="card-header">
        <h5 class="mb-0">Liste des Événements</h5>
    </div>

    <div class="card-body">
        {% if evenements|length > 0 %}
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Filière</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th>Capacité</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for ev in evenements %}
                        <tr>
                            <td>
                                <span style="font-weight: 600;">{{ ev.titre }}</span>
                            </td>
                            <td>
                                <span class="badge badge-info">{{ ev.filiere.nom }}</span>
                            </td>
                            <td>
                                {{ ev.dateDebut|date('Y-m-d H:i') }}
                            </td>
                            <td>
                                {{ ev.dateFin|date('Y-m-d H:i') }}
                            </td>
                            <td>{{ ev.capacite }}</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('admin_evenement_show', {id: ev.id}) }}" class="btn btn-sm btn-primary" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_evenement_edit', {id: ev.id}) }}" class="btn btn-sm btn-secondary" title="Éditer">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="POST" action="{{ path('admin_evenement_delete', {id: ev.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ ev.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
