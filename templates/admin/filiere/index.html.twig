{% extends 'admin/base.html.twig' %}

{% block title %}filieres{% endblock %}

{% block body %}

<section class="section courses" id="courses">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <div class="section-heading">
            <h6>Nos Formations</h6>
            <h2>Dernières Filières Ajoutées</h2>
          </div>
        </div>
      </div>
      
      <div class="row event_box">
        {% for filiere in filieres %}
        <div class="col-lg-4 col-md-6 align-self-center mb-30 event_outer">
          <div class="events_item">
            <div class="thumb">
              {# On peut mettre une image par défaut ou une image liée à la filière #}
              <a href="#"><img src="{{ asset('assets/images/course-01.jpg') }}" alt=""></a>
              <span class="category">{{ filiere.domaine }}</span>
            </div>
            <div class="down-content">
              <span class="author">Durée : {{ filiere.duree }} ans</span>
              <h4>{{ filiere.nom }}</h4>
              <p style="font-size: 0.9rem; color: #666;">
                {{ filiere.description|slice(0, 80) }}...
              </p>
            </div>
          </div>
        </div>
        {% else %}
            <p class="text-center">Aucune filière disponible pour le moment.</p>
        {% endfor %}
      </div>
    </div>
</section>
{% endblock %}

