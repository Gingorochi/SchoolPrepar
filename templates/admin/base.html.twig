{# templates/admin/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SchoolPrepar Admin{% endblock %}</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        /* THÈME SOMBRE PROFESSIONNEL */
        :root {
            --dark-bg: #0f1419;
            --dark-secondary: #1a1f2e;
            --dark-tertiary: #252d3d;
            --accent-primary: #4f46e5;
            --accent-secondary: #06b6d4;
            --text-primary: #f1f5f9;
            --text-secondary: #cbd5e1;
            --text-muted: #94a3b8;
            --border-color: rgba(148, 163, 184, 0.12);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
        }
        
        html, body {
            background: var(--dark-bg) !important;
            color: var(--text-primary) !important;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', sans-serif !important;
            height: 100%;
        }
        
        body {
            display: flex;
            overflow: hidden;
        }
        
        /* SIDEBAR NAVIGATION */
        #miniSidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 280px;
            background: linear-gradient(180deg, var(--dark-secondary) 0%, var(--dark-bg) 100%);
            border-right: 1px solid var(--border-color);
            z-index: 1000;
            overflow-y: auto;
            padding-top: 24px;
            flex-shrink: 0;
        }
        
        #miniSidebar::-webkit-scrollbar {
            width: 6px;
        }
        
        #miniSidebar::-webkit-scrollbar-track {
            background: transparent;
        }
        
        #miniSidebar::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 3px;
        }
        
        .brand-logo {
            padding: 0 24px 24px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 24px;
        }
        
        .brand-logo a {
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            color: white;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }
        
        .site-logo-text {
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* NAVIGATION */
        .navbar-nav {
            list-style: none;
            padding: 0;
        }
        
        .nav-heading {
            color: var(--text-muted);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 12px 24px 8px;
            margin: 8px 0 4px;
        }
        
        .nav-item {
            list-style: none;
        }
        
        .nav-link {
            padding: 10px 24px;
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 4px 8px;
            border-radius: 8px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            border-left: 3px solid transparent;
        }
        
        .nav-link:hover {
            color: var(--accent-primary);
            background: rgba(79, 70, 229, 0.1);
            transform: translateX(4px);
        }
        
        .nav-link.active {
            color: white;
            background: linear-gradient(90deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            border-left-color: white;
            box-shadow: var(--shadow-sm);
        }
        
        .nav-icon {
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: inherit;
        }
        
        .nav-line {
            border: none;
            height: 1px;
            background: var(--border-color);
            margin: 8px 0;
        }
        
        /* MAIN CONTENT */
        .main-wrapper {
            flex: 1;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        
        .topbar {
            position: sticky;
            top: 0;
            z-index: 999;
            background: var(--dark-secondary);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--shadow-sm);
            height: 70px;
            flex-shrink: 0;
        }
        
        .search-bar {
            position: relative;
            width: 320px;
        }
        
        .search-bar input {
            width: 100%;
            padding: 10px 16px 10px 40px;
            background: var(--dark-tertiary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        
        .search-bar input::placeholder {
            color: var(--text-muted);
        }
        
        .search-bar input:focus {
            outline: none;
            border-color: var(--accent-primary);
            background: rgba(79, 70, 229, 0.05);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
        
        .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }
        
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }
        
        .topbar-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 18px;
            transition: color 0.3s;
        }
        
        .topbar-btn:hover {
            color: var(--accent-primary);
        }
        
        /* MAIN CONTENT AREA */
        .main-content {
            flex: 1;
            overflow-y: auto;
            padding: 32px;
        }
        
        .main-content::-webkit-scrollbar {
            width: 8px;
        }
        
        .main-content::-webkit-scrollbar-track {
            background: transparent;
        }
        
        .main-content::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }
        
        .main-content::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.25);
        }
        
        /* CARDS */
        .card {
            background: var(--dark-tertiary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s;
        }
        
        .card:hover {
            border-color: var(--accent-primary);
            box-shadow: 0 8px 24px rgba(79, 70, 229, 0.15);
        }
        
        .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border-color);
            padding: 20px;
            color: var(--text-primary);
            font-weight: 600;
        }
        
        .card-body {
            padding: 20px;
            color: var(--text-secondary);
        }
        
        /* STATS CARD */
        .stats-card {
            background: linear-gradient(135deg, var(--dark-tertiary) 0%, rgba(79, 70, 229, 0.05) 100%);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
            transition: all 0.3s;
            box-shadow: var(--shadow-sm);
        }
        
        .stats-card:hover {
            border-color: var(--accent-primary);
            box-shadow: 0 8px 24px rgba(79, 70, 229, 0.15);
            transform: translateY(-4px);
        }
        
        .stats-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            flex-shrink: 0;
        }
        
        .stats-content h3 {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }
        
        .stats-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--text-primary);
            line-height: 1;
        }
        
        /* TABLES */
        .table {
            background: transparent;
            color: var(--text-primary);
            border-collapse: separate;
            border-spacing: 0;
            margin-bottom: 0;
        }
        
        .table thead th {
            background: rgba(79, 70, 229, 0.08);
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border: none;
            padding: 16px;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }
        
        .table tbody td {
            color: var(--text-secondary);
            padding: 16px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
        }
        
        .table tbody tr:hover {
            background: rgba(79, 70, 229, 0.05);
        }
        
        .table tbody tr:last-child td {
            border-bottom: none;
        }
        
        /* BADGES */
        .badge {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            display: inline-block;
        }
        
        .badge-success {
            background: rgba(34, 197, 94, 0.2);
            color: #86efac;
        }
        
        .badge-danger {
            background: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }
        
        .badge-warning {
            background: rgba(245, 158, 11, 0.2);
            color: #fcd34d;
        }
        
        .badge-info {
            background: rgba(79, 70, 229, 0.2);
            color: #a5b4fc;
        }
        
        /* BUTTONS */
        .btn {
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 10px 16px;
            transition: all 0.3s;
            border: none;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: white;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }
        
        .btn-primary:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
        }
        
        .btn-secondary {
            background: var(--dark-tertiary);
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }
        
        .btn-secondary:hover {
            color: var(--text-primary);
            border-color: var(--accent-primary);
            background: rgba(79, 70, 229, 0.1);
        }
        
        .btn-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
        }
        
        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.25);
            color: #fee2e2;
        }
        
        /* FORMS */
        .form-control, .form-select {
            background: var(--dark-tertiary);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        
        .form-control::placeholder {
            color: var(--text-muted);
        }
        
        .form-control:focus, .form-select:focus {
            background: var(--dark-tertiary);
            color: var(--text-primary);
            border-color: var(--accent-primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }
        
        .form-label {
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 8px;
        }
        
        /* FOOTER */
        .footer {
            background: var(--dark-secondary);
            border-top: 1px solid var(--border-color);
            padding: 20px 32px;
            color: var(--text-muted);
            font-size: 0.85rem;
            text-align: center;
            flex-shrink: 0;
        }
        
        /* RESPONSIVE */
        @media (max-width: 768px) {
            #miniSidebar {
                width: 240px;
            }
            
            .main-wrapper {
                margin-left: 240px;
            }
            
            .topbar {
                flex-wrap: wrap;
                height: auto;
                gap: 16px;
            }
            
            .search-bar {
                width: 100%;
            }
            
            .main-content {
                padding: 16px;
            }
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Sidebar #}
    {% include 'admin/partials/aside.html.twig' %}
    
    {# Main wrapper #}
    <div class="main-wrapper">
        {# Topbar #}
        {% include 'admin/partials/nav.html.twig' %}
        
        {# Main content #}
        <main class="main-content">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show mb-4" role="alert">
                        <strong>{{ type == 'error' ? 'Erreur' : 'Succès' }}!</strong> {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            
            {% block content %}{% endblock %}
        </main>
        
        {# Footer #}
        {% include 'admin/partials/footer.html.twig' %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>