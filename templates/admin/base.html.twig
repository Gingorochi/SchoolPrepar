{# templates/admin/base.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SchoolPrepar Admin{% endblock %}</title>
    
    {# Remarque le chemin : assets/admin/... #}
    <link rel="stylesheet" href="{{ asset('assets/admin/css/theme.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/admin/css/bootstrap.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Ta structure avec les includes #}
    {{ include('admin/partials/aside.html.twig') }}

    <div class="main-content">
        {% block body %}{% endblock %}
    </div>

    {# Scripts JS #}
    <script src="{{ asset('assets/admin/js/main.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>