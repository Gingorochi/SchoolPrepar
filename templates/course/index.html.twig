{% extends 'base.html.twig' %}

{% block title %}Cours{% endblock %}

{% block stylesheets %}
<style>
    .page-hero {
        background: linear-gradient(135deg, #1A56DB, #0D3B8C);
        color: white;
        padding: 3rem 2rem;
        text-align: center;
    }
    .page-hero h1 {
        font-size: 2rem;
        font-weight: 900;
        margin-bottom: 0.5rem;
    }
    .page-hero p {
        opacity: 0.85;
    }
    .section {
        padding: 3rem 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }
    .cours-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }
    .cours-card {
        border: 1px solid #E5E7EB;
        border-radius: 1rem;
        overflow: hidden;
        transition: all 0.2s;
        text-decoration: none;
        color: #111827;
        display: block;
    }
    .cours-card:hover {
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        transform: translateY(-4px);
    }
    .cours-card-header {
        background: #EFF6FF;
        padding: 1.25rem;
        border-bottom: 1px solid #E5E7EB;
    }
    .matiere {
        display: inline-block;
        background: #1A56DB;
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.65rem;
        border-radius: 2rem;
        margin-bottom: 0.75rem;
    }
    .cours-card-header h3 {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .meta {
        font-size: 0.8rem;
        color: #6B7280;
        display: flex;
        gap: 1rem;
    }
    .cours-card-footer {
        padding: 0.875rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .note {
        color: #F59E0B;
        font-weight: 700;
        font-size: 0.875rem;
    }
    .voir-btn {
        color: #1A56DB;
        font-size: 0.8rem;
        font-weight: 600;
    }
</style>
{% endblock %}

{% block body %}

    <section class="page-hero">
        <h1> Tous les Cours</h1>
        <p>{{ cours|length }} cours disponibles</p>
    </section>

    <section class="section">
        <div class="cours-grid">
            {% for c in cours %}
                <a href="#" class="cours-card">
                    <div class="cours-card-header">
                        <span class="matiere">{{ c.matiere }}</span>
                        <h3>{{ c.titre }}</h3>
                        <div class="meta">
                            <span> {{ c.niveau }}</span>
                            <span> {{ c.duree }} min</span>
                        </div>
                    </div>
                    <div class="cours-card-footer">
                        <span class="note">★ {{ c.note }}</span>
                        <span class="voir-btn">Voir →</span>
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>

{% endblock %}
