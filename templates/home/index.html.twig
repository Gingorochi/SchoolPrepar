{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block stylesheets %}
<style>
   
    .hero {
        background: linear-gradient(135deg, #1A56DB, #0D3B8C);
        color: white;
        text-align: center;
        padding: 5rem 2rem;
    }
    .hero h1 {
        font-size: 2.5rem;
        font-weight: 900;
        margin-bottom: 1rem;
    }
    .hero p {
        font-size: 1.1rem;
        opacity: 0.85;
        margin-bottom: 2rem;
    }
    .btn {
        background: #F59E0B;
        color: #111;
        padding: 0.8rem 2rem;
        border-radius: 0.5rem;
        font-weight: bold;
        text-decoration: none;
        font-size: 1rem;
    }

    
    .stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        background: #1A56DB;
        padding: 2rem;
        flex-wrap: wrap;
    }
    .stat {
        text-align: center;
        color: white;
    }
    .stat-valeur {
        font-size: 2rem;
        font-weight: 900;
    }
    .stat-label {
        font-size: 0.875rem;
        opacity: 0.8;
    }

    
    .section {
        padding: 4rem 2rem;
        max-width: 1100px;
        margin: 0 auto;
    }
    .section h2 {
        text-align: center;
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 2rem;
    }
    .matieres-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }
    .matiere-card {
        border: 1px solid #E5E7EB;
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.2s;
        text-decoration: none;
        color: #111827;
        display: block;
    }
    .matiere-card:hover {
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        transform: translateY(-4px);
        border-color: #1A56DB;
    }
    .matiere-card .icone {
        font-size: 2.5rem;
        margin-bottom: 0.75rem;
    }
    .matiere-card h3 {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .matiere-card p {
        font-size: 0.85rem;
        color: #6B7280;
    }
</style>
{% endblock %}

{% block body %}

    {# HERO #}
    <section class="hero">
        <h1> Préparez-vous à réussir vos examens</h1>
        <p>Des cours, exercices et annales pour le BEPC et le BAC</p>
        <a href="{{ path('course_index') }}" class="btn">
            Découvrir les cours →
        </a>
    </section>

    {# STATS #}
    <div class="stats">
        <div class="stat">
            <div class="stat-valeur">{{ stats.eleves }}+</div>
            <div class="stat-label">Élèves inscrits</div>
        </div>
        <div class="stat">
            <div class="stat-valeur">{{ stats.cours }}+</div>
            <div class="stat-label">Cours disponibles</div>
        </div>
        <div class="stat">
            <div class="stat-valeur">{{ stats.matieres }}</div>
            <div class="stat-label">Matières</div>
        </div>
        <div class="stat">
            <div class="stat-valeur">{{ stats.reussite }}%</div>
            <div class="stat-label">Taux de réussite</div>
        </div>
    </div>

    {# MATIERES #}
    <section class="section">
        <h2> Nos Matières</h2>
        <div class="matieres-grid">
            {% for matiere in matieres %}
                <a href="{{ path('course_index') }}" class="matiere-card">
                    
                    <h3>{{ matiere.nom }}</h3>
                    <p>{{ matiere.cours }} cours disponibles</p>
                </a>
            {% endfor %}
        </div>
    </section>

{% endblock %}